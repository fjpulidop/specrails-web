<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Desktop downloads moved to GitHub Releases (specrails-desktop openspec:
  # github-release-download-channel). Old links keep working: a versioned
  # folder opens its release, anything else the latest release.
  RewriteRule ^downloads/specrails-desktop/v([0-9]+\.[0-9]+\.[0-9]+)(/.*)?$ https://github.com/fjpulidop/specrails-desktop/releases/tag/v$1 [R=302,L]
  RewriteRule ^downloads/specrails-desktop(/.*)?$ https://github.com/fjpulidop/specrails-desktop/releases/latest [R=302,L]

  # If the request is for an existing file or directory, serve it directly
  RewriteRule ^index\.html$ - [L]

  # The companion PWA (Flutter web) lives at /companion-app. Real asset / wasm /
  # service-worker files exist on disk and are served directly by the !-f rule
  # below; any in-app deep link falls back to the COMPANION shell, never the
  # React marketing SPA.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^companion-app(/.*)?$ /companion-app/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Flutter web ships .wasm (canvaskit/skwasm); some hosts default to octet-stream.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/plain .md
</IfModule>

# Fallback: use index.html as the custom 404 page (LiteSpeed/Apache)
ErrorDocument 404 /index.html

# Prevent caching of the HTML shell so rewrites always take effect
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
